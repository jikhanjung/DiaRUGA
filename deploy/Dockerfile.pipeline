# diatom 파이프라인 이미지 (P03) — 그룹핑·합성·SAM2 검출·문턱 적용.
#
# CUDA 툴킷을 깔지 않는다 — torch cu126 휠이 CUDA 런타임을 들고 있고, 드라이버는
# nvidia 컨테이너 런타임이 호스트에서 넣어 준다. 그래서 slim 베이스로 충분하다.
#
# 이 컨테이너는 상주하지 않는다. `docker compose run --rm` 으로 일회성으로 돌린다 —
# 상주시키면 PyTorch 캐싱 할당자가 최대치 VRAM 을 물고 놓지 않는다 (P03 "버린 선택지").
#
# **diatom-base 를 FROM 하지 않는다.** 그렇게 했더니 코드 한 줄만 고쳐도 base 의
# COPY 층이 바뀌면서 그 위의 pip 층(6 GB, 10분)이 통째로 다시 깔렸다. 의존성을
# 코드보다 먼저 깔면 코드 수정은 마지막 층만 다시 만든다.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 사내 CA. KOPRI 망이 download.pytorch.org 의 TLS 를 가로채 자체 CA 로 다시
# 서명하는데 이미지에는 그 CA 가 없어 빌드가 막힌다. deploy/ca/README.md 참고.
# 비어 있으면(망 밖) update-ca-certificates 가 그냥 넘어간다.
COPY deploy/ca/ /usr/local/share/ca-certificates/

# SAM-2 를 git 에서 받는다 (requirements-pipeline.txt). 컴파일 확장은 없어서
# 빌드 도구는 필요 없다 — git 하나면 된다.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && update-ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# pip 은 기본적으로 certifi 묶음을 쓰고 시스템 저장소를 보지 않는다.
# 위에서 CA 를 깔아도 이 줄이 없으면 여전히 막힌다.
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# 의존성을 코드보다 먼저. requirements-pipeline.txt 가 -web 을 안에서 부른다.
#
# 설치 뒤 `import cv2` 로 확인한다 — 빌드가 조용히 성공하고 실행에서 죽는 것이
# 가장 나쁘다. (ultralytics 를 넣을 때는 GUI 판 opencv-python 이 headless 판을
# 가리므로 `pip uninstall -y opencv-python` 을 함께 넣어야 한다. 지금은
# ultralytics 를 안 넣는다 — requirements-pipeline.txt 참고)
COPY requirements-web.txt requirements-pipeline.txt ./
RUN pip install -r requirements-pipeline.txt \
      --extra-index-url https://download.pytorch.org/whl/cu126 \
 && python -c "import cv2; print('cv2', cv2.__version__)" \
 && apt-get purge -y git && apt-get autoremove -y

# SAM2 가중치는 HuggingFace 에서 받는다 (segment_diatoms.py:57 build_sam2_hf).
# 실행마다 다시 받지 않도록 볼륨으로 물린다 — compose 참고.
ENV HF_HOME=/hf \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache

# 코드는 마지막. 여기만 바뀌면 위 층들은 캐시가 그대로 산다.
COPY . .
