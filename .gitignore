__pycache__/
*.pyc

# 장비마다 다른 값 (데이터 위치, 비밀키). .env.template 이 견본이다
.env

# ../devdocs/guides 로 가는 심볼릭 링크. devdocs 는 private 이고 이 저장소는
# public 이라 커밋하지 않는다 (.guides/README.md 참고)
.guides

# 원본 이미지 — 촬영 데이터 (약 1 GB), 깃에 넣지 않는다.
# 지금은 /data3/diatom/photos/ 에 있다 (P03). 옛 경로를 남겨 둔다
260729/
photos/

# 파생 산출물 — 스크립트로 언제든 재생성 가능하고 용량이 크다
out/
out_hi/
stacked/
*.npy

.venv/

# DB 는 산출물이다 — JSON(review/ 포함)에서 다시 만들 수 있다.
# 사람의 교정은 review/*.json 으로 내보내 git 에 남긴다 (P02)
diatom.db
diatom.db-wal
diatom.db-shm

# 백업이 무결성 실패를 겪었다는 깃발 (db_sentinel.py). DB 옆에 놓이므로 개발
# 장비에서는 저장소 안에 생긴다. 그 장비의 지금 상태이지 코드가 아니다
INTEGRITY_FAIL

# DB 사본. backup_db.py 가 만든다 — 로컬 안전망이라 깃에 넣지 않는다
backup/

# 뷰어가 만드는 썸네일 캐시 — 원본에서 언제든 다시 생성된다
web/.thumbcache/

# devlog 는 .md 로만 둔다. docx 변환은 docs/ 의 보고서에만 한다.
devlog/*.docx

# 지도 자료 원본 — tools/README.md 의 명령으로 언제든 받는다
# (남극 1.6 MB · 한국 13 MB)
tools/*.geojson

# YOLO 학습 자료 꾸러미 — /data3/diatom/datasets 에 있고 export_yolo.py 로
# 언제든 다시 만든다 (판마다 344 MB)
datasets/

# 학습 산출물 — 가중치·그래프·예측 그림 (판마다 40~180 MB).
# 자료 꾸러미와 이 devlog 로 언제든 다시 만든다.
runs/
# 사전학습 가중치 — ultralytics 가 없으면 받아 온다
yolo11*.pt
